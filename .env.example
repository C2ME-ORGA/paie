# -----------------------------------------------------------------------------
# BatiPaie - modele d'environnement LOCAL (developpement)
#
# Copier ce fichier vers .env puis generer la cle applicative :
#   php artisan key:generate
#
# Ne jamais commiter .env. Les valeurs de production sont decrites dans
# .env.production.example et docs/development/ENVIRONMENTS.md.
# -----------------------------------------------------------------------------

APP_NAME=BatiPaie
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://paie.c2me.test

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# --- Journalisation (local) --------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de donnees locale --------------------------------------------------
# Creer un utilisateur MySQL applicatif dedie (voir
# docs/development/ENVIRONMENTS.md). Ne jamais utiliser le compte root.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=paie_c2me
DB_USERNAME=batipaie
DB_PASSWORD=

# --- Session -----------------------------------------------------------------
# En local (HTTP), le cookie de session ne doit pas etre marque "secure".
# En production (HTTPS), passer SESSION_SECURE_COOKIE a true.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Nom du cookie de session (par defaut : <nom-app>-session).
# SESSION_COOKIE=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

# --- Sanctum -----------------------------------------------------------------
SANCTUM_EXPIRATION=480
SANCTUM_TOKEN_PREFIX=bpa_
# Domaines autorises pour l'authentification SPA par cookie.
# Laisser vide tant que l'API utilise uniquement des tokens.
# SANCTUM_STATEFUL_DOMAINS=

# Rotation de cle : anciennes cles conservees pour dechiffrer les donnees
# existantes lors d'un remplacement d'APP_KEY.
# APP_PREVIOUS_KEYS=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Mail (local : ecrit dans les logs) --------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Stockage objet (non utilise actuellement) -------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
