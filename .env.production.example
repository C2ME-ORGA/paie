# -----------------------------------------------------------------------------
# BatiPaie - modele d'environnement PRODUCTION
# Cible : Ubuntu Server 24.04 LTS, aaPanel 8.x, Nginx, PHP-FPM, MySQL, Cron,
#         Supervisor. Voir docs/development/ENVIRONMENTS.md (section Production).
#
# Ce fichier ne contient AUCUNE valeur reelle : uniquement des placeholders.
# Le fichier .env de production est cree directement sur le serveur et n'est
# jamais versionne ni transmis par un canal non securise.
# -----------------------------------------------------------------------------

APP_NAME=BatiPaie
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://paie.example.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# Rotation de cle (uniquement lors d'un remplacement d'APP_KEY).
# APP_PREVIOUS_KEYS=

BCRYPT_ROUNDS=12

# --- Journalisation ----------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Base de donnees ---------------------------------------------------------
# Utilisateur applicatif dedie, privileges limites (DML uniquement).
# Les migrations utilisent un compte de deploiement distinct :
# voir docs/development/ENVIRONMENTS.md.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=paie_c2me
DB_USERNAME=batipaie
DB_PASSWORD=

# --- Session -----------------------------------------------------------------
# HTTPS obligatoire : cookie marque "secure".
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

# --- Sanctum -----------------------------------------------------------------
SANCTUM_EXPIRATION=480
SANCTUM_TOKEN_PREFIX=bpa_
# SANCTUM_STATEFUL_DOMAINS=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Administration -----------------------------------------------------------
# Duree de validite d'une invitation administrateur, en heures.
ADMIN_INVITATION_EXPIRY_HOURS=24

# --- Mail --------------------------------------------------------------------
# Renseigner l'hote, le port et les identifiants du fournisseur SMTP.
# MAIL_SCHEME=null laisse Laravel deduire le schema selon le port.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
